# Database Configuration
DB_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_db_password_here

# Backend Configuration
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
DATABASE_URL=mysql://maria_user:your_db_password_here@localhost:3306/maria_writer

# Encryption key for project data at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, project data is stored unencrypted (not recommended for production).
DATA_ENCRYPTION_KEY=

# Development
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost
