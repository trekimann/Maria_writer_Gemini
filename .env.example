# Database Configuration
DB_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_db_password_here

# Backend Configuration
DATABASE_URL=mysql://maria_user:your_db_password_here@localhost:3306/maria_writer

# JWT secrets — use two DIFFERENT random values, one per token type.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_different_from_above

# bcrypt cost factor. 12 is a good prod default (increase = slower hashing).
BCRYPT_ROUNDS=12

# Encryption key for project data at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Leave empty to disable encryption.
DATA_ENCRYPTION_KEY=

# Development
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost
