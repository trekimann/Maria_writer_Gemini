# Maria Writer - Unraid Environment Variables
# Copy these into the Unraid Docker Compose Manager stack env section,
# or place as .env alongside the compose file.

# Registry (where images are pulled from)
REGISTRY=192.168.0.189:5000

# Ports
FRONTEND_PORT=8084
BACKEND_PORT=3001
DB_PORT=3307

# CORS - must match how you access the frontend
CORS_ORIGIN=http://memoryalpha:8084

# Auth - CHANGE THIS to a random string (32+ characters)
JWT_SECRET=CHANGE_ME_/+7TtMgY0eG3lJMx/boob-boob-boop/8moKA==
